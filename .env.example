# Application
APP_NAME=ai-code-reviewer
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgresql+psycopg://reviewer:reviewer@localhost:5432/ai_code_reviewer
POSTGRES_USER=reviewer
POSTGRES_PASSWORD=reviewer
POSTGRES_DB=ai_code_reviewer

# GitHub App and API (never commit real values)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# Post a COMMENT review with inline notes for verified findings.
GITHUB_POST_REVIEWS=true

# LLM provider (LangChain). Provider is selected by LLM_PROVIDER.
# NVIDIA API Catalog (https://build.nvidia.com):
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
# Optional: LLM_API_KEY can be used instead of NVIDIA_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TEMPERATURE=0.0

# Embeddings / RAG
EMBEDDING_PROVIDER=openai
# Use `hash` for offline/local tests without an embedding API key.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_code_reviewer

# Timeouts (seconds)
GITHUB_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=120
